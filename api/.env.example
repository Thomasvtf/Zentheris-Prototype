# Plantilla: copia este archivo como api/.env y rellena los valores en tu equipo.
# api/.env nunca se sube a GitHub. Qué es cada variable y dónde se saca: guía de claves v3.

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=

# ===== Correo (Brevo, SMTP) =====
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=

# ===== App y reglas =====
APP_ENLACE_INVITACION=zentheris://invitacion?token=
ZONA_HORARIA=America/Bogota
RUTA_UMBRALES=app/config_files/umbrales-estado.v1.json
RUTA_TEXTOS_BACKEND=app/config_files/textos-backend.es-CO.json
CORS_ORIGENES=http://localhost:8081
